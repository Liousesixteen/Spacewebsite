# =============================================================================
# SpaceData Environment Variables
# Copy this file to .env (local dev) or configure in your deployment platform.
# =============================================================================

# ---- Database ----
# Neon PostgreSQL connection (production). For local dev, use a local PostgreSQL:
#   brew install postgresql@16 && brew services start postgresql@16
#   createdb spacewebsite
DATABASE_URL="postgresql://user:password@localhost:5432/spacewebsite?schema=public&connection_limit=5&pool_timeout=10"

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Auth (NextAuth.js v5 / Auth.js) ----
# Generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here
AUTH_SECRET=your-secret-here

# ---- OAuth Providers (optional) ----
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Cron ----
# Shared secret for Vercel Cron Job authorization.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# ---- Data Sources ----
# Launch Library 2: https://ll.thespacedevs.com/2.3.0
# Anonymous: 15 req/hour. API key gives higher limits.
LL2_API_BASE=https://ll.thespacedevs.com/2.3.0
LL2_API_KEY=
LL2_DELAY_MS=200

# CelesTrak (public — respect usage policy: download only needed data)
CELESTRAK_BASE=https://celestrak.org

# ---- Cache & Queue (future) ----
# REDIS_URL=redis://localhost:6379

# ---- Monitoring (future) ----
# SENTRY_DSN=
