// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 枚举类型
enum LaunchStatus {
  SUCCESS
  FAILURE
  PLANNED
  POSTPONED
  IN_FLIGHT
}

enum RocketStatus {
  ACTIVE
  RETIRED
  IN_DEVELOPMENT
}

enum SpacecraftType {
  SPACE_STATION
  SATELLITE
  PROBE
  CREWED_SPACECRAFT
  CARGO_SPACECRAFT
}

enum SpacecraftStatus {
  OPERATIONAL
  RETIRED
  LOST
}

enum AstronautStatus {
  ACTIVE
  RETIRED
  DECEASED
}

enum LaunchSiteStatus {
  ACTIVE
  INACTIVE
  UNDER_CONSTRUCTION
}

model Rocket {
  id            String       @id @default(cuid())
  name          String
  manufacturer  String
  country       String
  height        Float
  diameter      Float
  mass          Float
  payloadToLEO  Float
  payloadToGTO  Float
  stages        Int
  firstFlight   DateTime?
  status        RocketStatus
  successRate   Float        @default(0)
  description   String       @db.Text
  images        String[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  launches      Launch[]

  @@index([country])
  @@index([status])
}

model Agency {
  id            String    @id @default(cuid())
  name          String
  abbrev        String?
  type          String?
  country       String
  description   String?   @db.Text
  administrator String?
  foundingYear  Int?
  logo          String?
  website       String?
  externalId    String?   @unique
  source        String?
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  launches      Launch[]

  @@index([country])
  @@index([name])
  @@index([source])
}

model LaunchSite {
  id          String           @id @default(cuid())
  name        String
  country     String
  region      String
  latitude    Float
  longitude   Float
  operator    String
  status      LaunchSiteStatus
  pads        Json
  description String           @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  launches    Launch[]
  padsDetailed LaunchPad[]

  @@index([country])
  @@index([status])
}

model LaunchPad {
  id            String           @id @default(cuid())
  name          String
  country       String
  region        String?
  latitude      Float?
  longitude     Float?
  status        LaunchSiteStatus @default(ACTIVE)
  mapUrl        String?
  externalId    String?          @unique
  source        String?
  lastSyncedAt  DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  launchSiteId  String
  launchSite    LaunchSite       @relation(fields: [launchSiteId], references: [id], onDelete: Cascade)
  launches      Launch[]

  @@index([country])
  @@index([status])
  @@index([launchSiteId])
  @@index([name])
}

model Astronaut {
  id               String          @id @default(cuid())
  name             String
  nationality      String
  agency           String
  birthDate        DateTime
  status           AstronautStatus
  spaceFlights     Int             @default(0)
  totalTimeInSpace Int             @default(0)
  bio              String          @db.Text
  photo            String?
  socialLinks      Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  launchCrews      LaunchCrew[]

  @@index([nationality])
  @@index([agency])
  @@index([status])
  @@index([totalTimeInSpace(sort: Desc)])
}

model Spacecraft {
  id               String           @id @default(cuid())
  name             String
  type             SpacecraftType
  operator         String
  launchDate       DateTime
  status           SpacecraftStatus
  orbitType        String
  orbitAltitude    Float?
  orbitInclination Float?
  orbitPeriod      Float?
  mass             Float
  dimensions       String
  mission          String           @db.Text
  description      String           @db.Text
  images           String[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  payloads         Payload[]

  @@index([type])
  @@index([status])
  @@index([operator])
  @@index([launchDate(sort: Desc)])
}

model Launch {
  id                 String       @id @default(cuid())
  name               String
  date               DateTime
  status             LaunchStatus
  missionDescription String       @db.Text
  missionName        String?
  missionType        String?
  orbitName          String?
  orbitAbbrev        String?
  windowStart        DateTime?
  windowEnd          DateTime?
  slug               String?
  payloads           Json
  videoUrl           String?
  webcastUrl         String?
  articleUrl         String?
  wikiUrl            String?
  images             String[]
  externalId         String?      @unique
  source             String?
  sourceUrl          String?
  lastSyncedAt       DateTime?
  rawStatus          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  rocketId           String
  rocket             Rocket       @relation(fields: [rocketId], references: [id])

  launchSiteId       String
  launchSite         LaunchSite   @relation(fields: [launchSiteId], references: [id])

  agencyId           String?
  agency             Agency?      @relation(fields: [agencyId], references: [id])

  launchPadId        String?
  launchPad          LaunchPad?   @relation(fields: [launchPadId], references: [id])

  crews              LaunchCrew[]
  payloadRecords     Payload[]

  @@index([date])
  @@index([status])
  @@index([rocketId])
  @@index([launchSiteId])
  @@index([agencyId])
  @@index([launchPadId])
  @@index([missionType])
  @@index([orbitName])
  @@index([lastSyncedAt])
  @@index([date(sort: Desc)], map: "Launch_date_desc_idx")
}

model Payload {
  id                      String      @id @default(cuid())
  name                    String
  type                    String?
  orbit                   String?
  owner                   String?
  operator                String?
  noradId                 Int?
  internationalDesignator String?
  massKg                  Float?
  externalId              String?     @unique
  source                  String?
  lastSyncedAt            DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  launchId                String
  launch                  Launch      @relation(fields: [launchId], references: [id], onDelete: Cascade)

  spacecraftId            String?
  spacecraft              Spacecraft? @relation(fields: [spacecraftId], references: [id])

  @@index([launchId])
  @@index([spacecraftId])
  @@index([owner])
  @@index([operator])
  @@index([noradId])
}

model LaunchCrew {
  id          String    @id @default(cuid())
  launchId    String
  launch      Launch    @relation(fields: [launchId], references: [id], onDelete: Cascade)
  astronautId String
  astronaut   Astronaut @relation(fields: [astronautId], references: [id])
  role        String

  @@unique([launchId, astronautId])
}

model DataSourceRecord {
  id           String   @id @default(cuid())
  source       String
  entityType   String
  externalId   String
  internalId   String?
  lastSyncedAt DateTime @default(now())
  status       String
  message      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([source, entityType, externalId])
  @@index([source])
  @@index([entityType])
  @@index([status])
}

// 产业链相关枚举
enum IndustryLevel {
  UPSTREAM
  MIDSTREAM
  DOWNSTREAM
}

enum CompanyType {
  STATE_OWNED
  PRIVATE
  PUBLIC
  STARTUP
}

enum TechnologyMaturity {
  RESEARCH
  EXPERIMENTAL
  APPLIED
  MATURE
}

model IndustrySegment {
  id           String           @id @default(cuid())
  name         String
  level        IndustryLevel
  category     String
  description  String           @db.Text
  technologies String[]
  marketSize   Float?
  growthRate   Float?
  challenges   String[]
  trends       String[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  companies    CompanySegment[]

  @@index([level])
  @@index([category])
}

model Company {
  id           String           @id @default(cuid())
  name         String
  country      String
  type         CompanyType
  foundedYear  Int
  headquarters String
  employees    Int?
  revenue      Float?
  products     String[]
  achievements String[]
  website      String?
  stockCode    String?
  description  String           @db.Text
  logo         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  segments          CompanySegment[]
  capabilities      ProductCapability[]
  relationshipsFrom OrganizationRelationship[] @relation("FromCompany")
  relationshipsTo   OrganizationRelationship[] @relation("ToCompany")

  @@index([country])
  @@index([type])
  @@index([name])
}

model CompanySegment {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  segmentId String
  segment   IndustrySegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([companyId, segmentId])
  @@index([companyId])
  @@index([segmentId])
}

model Technology {
  id            String             @id @default(cuid())
  name          String
  category      String
  maturityLevel TechnologyMaturity
  description   String             @db.Text
  applications  String[]
  keyPlayers    String[]
  challenges    String[]
  breakthroughs Json
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([category])
  @@index([maturityLevel])
  @@index([name])
}

model Material {
  id            String   @id @default(cuid())
  name          String
  category      String
  properties    Json
  applications  String[]
  manufacturers String[]
  description   String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([name])
}

model Equipment {
  id             String   @id @default(cuid())
  name           String
  category       String
  manufacturer   String
  specifications Json
  applications   String[]
  description    String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([manufacturer])
  @@index([name])
}

// 用户系统相关枚举
enum UserRole {
  USER
  ADMIN
}

enum FavoriteType {
  LAUNCH
  ROCKET
  SPACECRAFT
  ASTRONAUT
  COMPANY
  TECHNOLOGY
}

enum CommentTargetType {
  LAUNCH
  ROCKET
  SPACECRAFT
  ASTRONAUT
  COMPANY
  TECHNOLOGY
}

// NextAuth 模型
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(USER)
  locale        String    @default("zh-CN")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  favorites  Favorite[]
  comments   Comment[]
  watchlists Watchlist[]
  alertRules AlertRule[]
  apiKeys    ApiKey[]

  @@index([email])
}

model Favorite {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType FavoriteType
  targetId   String
  createdAt  DateTime     @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId])
  @@index([targetType, targetId])
}

model Comment {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType CommentTargetType
  targetId   String
  content    String            @db.Text
  parentId   String?
  parent     Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[]         @relation("CommentReplies")
  likes      Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([userId])
  @@index([targetType, targetId])
  @@index([parentId])
}

model SyncRun {
  id             String   @id @default(cuid())
  source         String
  status         String   @default("PENDING")
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  recordsAdded   Int      @default(0)
  recordsUpdated Int      @default(0)
  recordsSkipped Int      @default(0)
  cursor         String?
  error          String?  @db.Text
  version        String?
  createdAt      DateTime @default(now())

  @@index([source])
  @@index([status])
  @@index([startedAt])
}

model ChangeEvent {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  field      String
  oldValue   String?  @db.Text
  newValue   String?  @db.Text
  source     String
  detectedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([detectedAt])
}

model Watchlist {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  label      String?
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId])
  @@index([targetType, targetId])
}

model AlertRule {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType      String
  targetId        String?
  eventType       String
  minutesBefore   Int?
  enabled         Boolean  @default(true)
  quietStart      String?
  quietEnd        String?
  lastTriggeredAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([enabled])
  @@index([eventType])
}

model NotificationDelivery {
  id           String   @id @default(cuid())
  userId       String
  alertRuleId  String?
  channel      String
  targetType   String
  targetId     String?
  subject      String
  body         String   @db.Text
  status       String   @default("PENDING")
  idempotencyKey String @unique
  deliveredAt  DateTime?
  error        String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([idempotencyKey])
  @@index([status])
  @@index([createdAt])
}

model EntityAlias {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  alias      String
  language   String?
  aliasType  String   @default("ALTERNATIVE")
  source     String?
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([entityType, entityId, alias])
  @@index([entityType, entityId])
  @@index([alias])
}

model FieldEvidence {
  id              String   @id @default(cuid())
  entityType      String
  entityId        String
  field           String
  value           String?  @db.Text
  source          String
  sourceUrl       String?
  observedAt      DateTime?
  confidence      Float?
  factType        String   @default("OBSERVED")
  reviewerId      String?
  reviewStatus    String   @default("UNREVIEWED")
  createdAt       DateTime @default(now())

  @@index([entityType, entityId])
  @@index([source])
  @@index([reviewStatus])
}

model ProductCapability {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  description  String?  @db.Text
  category     String?
  maturityLevel String?
  source       String?
  sourceUrl    String?
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
  @@index([category])
}

model OrganizationRelationship {
  id            String   @id @default(cuid())
  fromCompanyId String
  fromCompany   Company  @relation("FromCompany", fields: [fromCompanyId], references: [id], onDelete: Cascade)
  toCompanyId   String
  toCompany     Company  @relation("ToCompany", fields: [toCompanyId], references: [id], onDelete: Cascade)
  relationType  String
  description   String?  @db.Text
  source        String?
  sourceUrl     String?
  startDate     DateTime?
  endDate       DateTime?
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([fromCompanyId])
  @@index([toCompanyId])
  @@index([relationType])
}

model MarketMetric {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String
  metricName    String
  metricValue   Float
  unit          String?
  currency      String?
  baseYear      Int?
  region        String?
  source        String?
  sourceUrl     String?
  methodology   String?  @db.Text
  factType      String   @default("ESTIMATED")
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([metricName])
}

model ApiKey {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  keyHash       String   @unique
  keyPrefix     String
  permissions   String[]
  rateLimitRpm  Int      @default(60)
  monthlyQuota  Int      @default(10000)
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([keyHash])
}

model UsageRecord {
  id          String   @id @default(cuid())
  apiKeyId    String
  endpoint    String
  statusCode  Int
  timestamp   DateTime @default(now())

  @@index([apiKeyId])
  @@index([timestamp])
}
